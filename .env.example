# Copy this file to .env.local and fill in the values you have.
# .env.local is gitignored — never commit real keys.
# Restart `npm run dev` after changing anything here.

# ── The Guardian Open Platform ──────────────────────────────
# Optional. Without it, Guardian content is pulled from their public RSS feeds.
# With it, the four Guardian sources switch to the Content API automatically,
# which returns better summaries and larger images.
# Request a free developer key at https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=

# Keys are read server-side only (see lib/sources/api.ts) and are never
# exposed to the browser. Do not prefix them with NEXT_PUBLIC_.
